FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake git \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev

COPY src/ ./src/
COPY config.yaml README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev

FROM python:3.12-slim-bookworm AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 eta \
    && useradd --system --uid 1001 --gid eta --no-create-home eta

WORKDIR /app

COPY --from=builder --chown=eta:eta /app/.venv /app/.venv
COPY --from=builder --chown=eta:eta /app/src /app/src
COPY --from=builder --chown=eta:eta /app/config.yaml /app/config.yaml

VOLUME ["/app/artifacts", "/app/data/processed"]

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ETA_ENV=prod

USER eta
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "eta.serving.app:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "2", \
     "--log-config", "/dev/null"]
